generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum MonitorMode {
  WATCH_ONLY
  RECORD
}

model Monitor {
  id            Int            @id @default(autoincrement())
  name          String
  url           String?
  mode          MonitorMode    @default(WATCH_ONLY)
  monitorId     String         @unique()
  createdAt     DateTime       @default(now())
  eventMonitors EventMonitor[]
}

model Video {
  id             Int           @id @default(autoincrement())
  filename       String
  url            String
  startAt        DateTime      @default(now())
  createdAt      DateTime      @default(now())
  eventMonitor   EventMonitor? @relation(fields: [eventMonitorId], references: [id])
  eventMonitorId Int?
}

model EventMonitor {
  id        Int      @id @default(autoincrement())
  videos    Video[]
  monitor   Monitor  @relation(fields: [monitorId], references: [id])
  monitorId Int
  event     Event?   @relation(fields: [eventId], references: [id])
  eventId   Int?
  createdAt DateTime @default(now())
}

enum EventStatus {
  RECORDING
  FINISHED
}

model Event {
  id        Int            @id @default(autoincrement())
  name      String
  status    EventStatus    @default(RECORDING)
  monitors  EventMonitor[]
  createdAt DateTime       @default(now())
}
